    },
    {
      "url": "heroku/python"
    }
  ],
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "env": {
    "SPOTIFY_CLIENT_ID": {
      "description": "Spotify Developer Client ID",
      "value": "your_spotify_client_id_here"
    },
    "SPOTIFY_CLIENT_SECRET": {
